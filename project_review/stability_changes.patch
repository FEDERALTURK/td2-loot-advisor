+        root = FakeRoot()
+        trail = fx.TrailFX(root)
+        trail.alive, trail.win, trail.cv = True, FakeWindow(), root
+        trail._tick()
+        self.assertEqual(root.draws, 0)
+        self.assertEqual(root.jobs[-1][0], 300)
+        self.assertTrue(trail.alive)
+        root._td2_suspend_animations = False
+        root.jobs[-1][1]()
