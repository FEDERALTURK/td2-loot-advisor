+        await edge_tts.Communicate(text, voice, rate=f"{rate:+d}%", pitch="+0Hz",
+                                   connect_timeout=10, receive_timeout=25).save(str(path))
+    with tempfile.NamedTemporaryFile(dir=cache, suffix=".part", delete=False) as tmp:
+        part = Path(tmp.name)
