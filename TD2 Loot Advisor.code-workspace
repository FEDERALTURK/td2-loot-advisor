{
  "folders": [
    { "path": "." },
    { "path": "mobile" },
    { "path": "server" }
  ],
  "settings": {
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",
    "python.testing.pytestEnabled": false,
    "python.testing.unittestEnabled": true,
    "python.testing.unittestArgs": ["tests"],
    "files.exclude": {
      "**/__pycache__": true,
      "**/.dart_tool": true,
      "**/build": true,
      "**/dist": true,
      "**/cache": true,
      "**/logs": true,
      "**/node_modules": true,
      "**/project_review": true,
      "**/Claude outputs": true
    },
    "search.exclude": {
      "**/build": true,
      "**/dist": true,
      "**/cache": true,
      "**/logs": true,
      "**/node_modules": true,
      "**/project_review": true,
      "**/Claude outputs": true
    }
  },
  "extensions": {
    "recommendations": [
      "ms-python.python",
      "ms-python.vscode-pylance",
      "Dart-Code.flutter",
      "Dart-Code.dart-code"
    ]
  }
}
