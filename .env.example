# TD2 Loot Advisor local development template
# Copy to .env only when a component explicitly supports dotenv loading.
# Never commit real credentials, tokens, keystores, or service-account JSON.

# Optional local Cloudflare Worker endpoint
TD2_API_BASE_URL=http://127.0.0.1:8787

# Optional local LiteLLM proxy
LITELLM_BASE_URL=http://localhost:4000/v1
LITELLM_API_KEY=

# Optional server/admin values. Keep empty for local tests.
TD2_ADMIN_TOKEN=
FCM_SERVICE_ACCOUNT_JSON=

# Optional Supabase panel integration (server-side only)
# The URL is safe to expose in configuration; never put service-role keys in
# desktop/mobile client builds or browser JavaScript.
SUPABASE_URL=https://ukbbwubktohifdomhcks.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# New backend-only key format (preferred): sb_secret_...
SUPABASE_SECRET_KEY=
# Legacy fallback, only if the project still uses the old service_role key.
SUPABASE_SERVICE_ROLE_KEY=
