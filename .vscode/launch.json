{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "TD2 Loot Advisor (source)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/launch.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Local API tests",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "args": ["discover", "-s", "tests", "-p", "test_localapi*.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
